{
  "name": "ozone-enterprise-erp",
  "productName": "OZONE Enterprise ERP",
  "description": "Multi-company ERP and voucher management system",
  "author": "Syed Shoaib Ali Shah Bukhari (Bukharihub)",
  "copyright": "© 2026 Syed Shoaib Ali Shah Bukhari (Bukharihub). All Rights Reserved.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win nsis --x64",
    "electron:build:company": "node scripts/build-company.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.ozone.enterprise",
    "productName": "OZONE Enterprise ERP",
    "copyright": "© 2026 Syed Shoaib Ali Shah Bukhari (Bukharihub). All Rights Reserved.",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OZONE-Enterprise-Setup-${version}.${ext}",
      "signtoolOptions": {
        "publisherName": "Syed Shoaib Ali Shah Bukhari (Bukharihub)"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OZONE Enterprise ERP"
    }
  },
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4.3.5",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "next": "16.4.6",
    "postcss": "^8.5.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
